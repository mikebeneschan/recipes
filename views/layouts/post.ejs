<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="msvalidate.01" content="D9259A70D269914A445217A8EB07A7B5" />
  <meta name="description" content="<%=data.subtitle%>"/>
  <title><%= data.title %></title>
  <link rel="stylesheet" href="/style.css">
  <link rel="icon" type="image/png" href="/favicon/favicon-96x96.png" sizes="96x96" />
  <link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
  <link rel="shortcut icon" href="/favicon/favicon.ico" />
  <link rel="manifest" href="/favicon/site.webmanifest" />
</head>
<body>
  <!-- Header -->
  <%- include('../partials/header') %>

  <!-- Main Page Content -->
  <main style="max-width: min(80%, 850px); min-width: min(80%, 850px)">
    <h1 style="margin-bottom: 4px"><%= data.title %></h1>
    <p class="st st-post" style="margin: 2px; color: #81b29a; font-style: italic"><%=data.subtitle%></p>
    <div style="display:flex; flex-direction: row;">
      <% data.tags.forEach(function(tag){ %>

        <div class="tag-cont">
          <a class="no-bold" href="/recipe-index?tags=<%- tag %>">
          <p class="tag tag-<%- tag %>"><%- tag %></p>
          </a>
        </div>
      <% }) %>
    </div> 
    <div style="position: relative">
      <img id="mainimg" src = "<%= data.image %>" aspect-ratio=1 height="400px" style="margin-top: 10px;">
      <!-- <img id="sneaky" class= "gerald1" src="/images/sneakygerald.png"> -->
    </div>
    <p><%- data.content %></p>

    <h1>Recipe</h1>
    <div style="position: relative">
      <img id="sneaky2" class="gerald1" src="/images/sneakygerald.png" >

      <div class="recipe-container">
        <div style="display: flex; flex-direction:row">
          <div>
            <h2 style="margin-top: 0px; margin-bottom: 0px;"><%= data.title %></h2>
            <% if(data.recipeCards.length>0 && data.recipeCards[0].servingSize){ %>
              <p class="st" style="margin-top: 0;"><%= data.recipeCards[0].servingSize %></p>
            <% } %>
          </div>
          <div class="img-cont" style="margin-left: auto;">
              <img class="foodpic" style="border-radius: 12px;z-index:1" src = "<%= data.image %>">
          </div>
        </div>
        <h3>Ingredients</h3>
        <ul>
        <!-- loop to display ingredients -->
        <% if(data.recipeCards.length>0){ %>
          <% data.recipeCards[0].ingredients.forEach(function(ingGrp){ %>
            <h3 style="margin-bottom: 0%; font-size: 95%; text-decoration: underline"><%- ingGrp.sectionName %></h3>
            <% ingGrp.ings.forEach(function(ing){%>
              <li><%- ing %></li>
            <% }) %>
          <% }) %>
        <% } %>
        </ul>

        <h3>Steps</h3>
        <ol>
        <!-- loop to display steps -->
        <% if(data.recipeCards.length>0){ %>
          <% data.recipeCards[0].procedure.forEach(function(step){ %>
            <li><%- step %></li>
          <% }) %>
        <% } %>
        </ol>    
      </div>
    </div>
  </main>

  <!-- Footer -->
  <!-- <%- include('../partials/footer') %> -->
   <script>
      let i = document.querySelector("#mainimg")
      let g = document.querySelector("#sneaky")
      i.addEventListener("mouseover", () => {
        g.classList.toggle("gerald2")
        g.classList.toggle("gerald1")
      })
      i.addEventListener("mouseout", () => {
        g.classList.toggle("gerald2")
        g.classList.toggle("gerald1")
      })

      let i2 = document.querySelector(".recipe-container")
      let g2 = document.querySelector("#sneaky2")
      i2.addEventListener("mouseover", () => {
        g2.classList.toggle("gerald2")
        g2.classList.toggle("gerald1")
      })
      i2.addEventListener("mouseout", () => {
        g2.classList.toggle("gerald2")
        g2.classList.toggle("gerald1")
      })

   </script>
</body>
<footer>
  <%- include ('../partials/footer') %>
</footer>
</html>