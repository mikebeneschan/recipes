<script src="../darkmode.js" defer></script>
<script>
  if (localStorage.getItem("darkmode")==="true"){
    document.body.classList.add("dark-mode")
  }
</script>
  <!-- Rounded switch -->
  <label class="switch">
    <input type="checkbox" id="dm-switcher">
    <span class="slider round">
      <img id="dm-svg-lm" class="dm-svg" height="22px" width="22px" style="left:3px" src="../svgs/lightmode.svg">
      <img id="dm-svg-dm" class="dm-svg" height="22px" width="22px" style="left:7px" src="../svgs/darkmode.svg">
    </span>

  </label>
<header >
  <div id="banner-cont" style="display:grid">
    <img id="banner" class="banner" src = "/images/header-lm.png" style = "z-index:2" alt="Mike B. Cooking">
    <img id="bannerAni" class="banner" src = "/images/header-lm-ani.gif" style = "z-index:1; opacity:0" alt="Mike B. Cooking">

  </div>
  <hr class="header-hr" style="min-width: 1000px">
  <nav style="display: flex;flex-direction:row">
    <div><a href="/" class="navlink"> Home</a>|</div>
    <div><a href="/about" class="navlink"> About</a>|</div>
    <div><a href="/recipe-index" class="navlink"> All Recipes</a>|</div>
    <div><a href="/contact" class="navlink"> Contact</a>| </div>
  <form id="searchform" class="search2" method="get" action="source.html">
    <input id="searchinput" type="text" name="search" size="10" maxlength="255" placeholder="🔎" style="color: black;background-color:white;border-radius: 12px;margin-left: 20px;border: 1px solid black;height: 22px;vertical-align: middle;">
    <button type="submit" style="height: auto; font-size: 15px; width: auto; padding-left: 10px; padding-right: 10px; border-radius: 15px; vertical-align: middle">Search</button>
  </form>  
  </nav>
  <hr class="header-hr">
</header>
<script>
  bannerStatic = document.getElementById("banner")
  bannerAni = document.getElementById("bannerAni")
  bannerStatic.addEventListener('mouseover', ()=> {
    bannerStatic.style.opacity="0"
    bannerAni.style.opacity="1"
  })
  bannerStatic.addEventListener('mouseleave', () => {
    bannerStatic.style.opacity="1"
    bannerAni.style.opacity="0"

  })
</script>
<script type="text/javascript">
document.getElementById('searchform').onsubmit = function() {
    window.location = 'http://www.duckduckgo.com/search?q=site:https://mikeb.cooking/ ' + document.getElementById('searchinput').value;
    return false;
}
</script>