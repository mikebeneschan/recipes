<script src="../darkmode.js" defer></script>
<script>
  if (localStorage.getItem("darkmode")==="true"){
    document.body.classList.add("dark-mode")
  }
</script>
  <!-- Rounded switch -->
  <label class="switch">
    <input type="checkbox" id="dm-switcher">
    <span class="slider round">
      <img id="dm-svg-lm" class="dm-svg" height="22px" width="22px" style="left:3px" src="../svgs/lightmode.svg">
      <img id="dm-svg-dm" class="dm-svg" height="22px" width="22px" style="left:7px" src="../svgs/darkmode.svg">
    </span>

  </label>
<header >
  <div id="banner-cont" style="display:grid;">
    <img id="banner" class="banner" src = "/images/header-lm.png" style = "height:100px; z-index:2" alt="Mike B. Cooking">
    <img id="bannerAni" class="banner" src = "/images/header-lm-ani.gif" style = "height:100px; z-index:1; opacity:0" alt="Mike B. Cooking">

  </div>
  <nav style="padding: 1rem; display: flex;flex-direction:row">
    <div><a href="/" class="navlink"> Home</a>|</div>
    <div><a href="/about" class="navlink"> About</a>|</div>
    <div><a href="/recipe-index" class="navlink"> All Recipes</a>|</div>
    <div><a href="/contact" class="navlink"> Contact</a> </div>

  </nav>
</header>
<script>
  bannerStatic = document.getElementById("banner")
  bannerAni = document.getElementById("bannerAni")
  bannerStatic.addEventListener('mouseover', ()=> {
    bannerStatic.style.opacity="0"
    bannerAni.style.opacity="1"
  })
  bannerStatic.addEventListener('mouseleave', () => {
    bannerStatic.style.opacity="1"
    bannerAni.style.opacity="0"

  })
</script>