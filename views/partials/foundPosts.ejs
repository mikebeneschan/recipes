<% if (data.length === 0 && q!=0) { %>
  <p>No posts found.</p>
  <div id="catimgcont" style="text-align: center;">
    <img class="light-only" src = "/images/catnothinghere.png" style = "height: 350px; width: auto; text-align: center;" alt="crude drawing of a cat saying the following: Nothing here!">
    <img class="dark-only" src = "/images/catnothingheredarkmode.png" style = "height: 350px; width: auto; text-align: center;" alt="crude drawing of a cat saying the following: Nothing here! Wow, dark mode!">
  </div>
<% } %>

<% data.forEach(function(post){ %>
        <div class="cont">
            <a class="recipe-card-link" href="/recipes/<%= post.slug %>">
               <li id="found-post">
                    <div>
                        <a style=" font-size: 28px; line-height: 26px;" href="/recipes/<%= post.slug %>"><%=post.title%></a>
                        <% if(post.subtitle){ %>
                        <p class="st" style="font-size: 18px"><%=post.subtitle%></p>
                        <% } %>
                        <div id="fp-tag-cont">
                            <div style="display: flex; flex-direction:row">
                                <% post.tags.forEach(function(tag){ %>
                                    <div class="tag-cont" style="opacity:1">
                                    <a class="no-bold" href="/recipe-index?tags=<%- tag %>">
                                    <p class="tag tag-<%- tag %>"><%- tag %></p>
                                    </a>
                                    </div>
                                <% }) %>
                            </div> 
                        </div>
                    </div>
                    <div class="img-cont img-hp" style="margin-left: auto;">
                        <img class="foodpic" src = "/images/<%= post.image %>">
                    </div>
    
                </li>
    
            </a>
            </div>
    
            <hr style="margin-top: 8px">
<% }) %>