<a class="recipe-card-link" href="/recipes/<%= hero.slug %>">
    <li style="display: flex; flex-direction:row">
        <div class="hero-textbox">
            <a id="hero-title-text" style=" font-size: 50px; font-weight:600; line-height: 26px;" href="/recipes/<%= hero.slug %>"><%=hero.title%></a>
            <% if(hero.subtitle){ %>
            <p class="st" style="font-size: 23px"><%=hero.subtitle%></p>
            <% } %>
        </div>
        <div class="img-cont img-hero" style="margin-left: auto;">
            <img class="foodpic" src = "/images/<%= hero.image %>">
        </div>
    </li>
</a>
