<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tags</title>
</head>
<body>
    <h1>Tags</h1>
    <h2 class="st">This is the tags page</h2>
    <!-- probably some way in the future to make a list of tags -->
    <!-- <div id="selectedTagBox" style="height: 57px"></div> -->
    <!-- <h3 style="margin-top: 0%;">Tags</h3> -->
    <div id="possibleTagBox" style="display: flex; flex-direction: row;">
        <h3 style="margin-right: 10px">Tags:</h3>
        <div class="tag-cont">
            <p class="tag tag-Alcohol inactive">Alcohol</p>
        </div>

        <div class="tag-cont">
            <p class="tag tag-Dessert inactive">Dessert</p>
        </div>
        <div class="tag-cont">
            <p class="tag tag-Drink inactive">Drink</p>
        </div>
        <div class="tag-cont">
            <p class="tag tag-Family-sized inactive">Family-sized</p>
        </div>
        <div class="tag-cont">
            <p class="tag tag-Italian inactive">Italian</p>
        </div>
        <div class="tag-cont">
            <p class="tag tag-Korean inactive">Korean</p>
        </div>
        <div class="tag-cont">
            <p class="tag tag-Pasta inactive">Pasta</p>
        </div>
        <div class="tag-cont">
            <p class="tag tag-Vegetarian inactive">Vegetarian</p>
        </div>

        
        
    </div>

    <br>
    
    <h2 class="st">Results: </h2>
    <hr>

    <div id="tagPostCont">
    <%- include('partials/foundPosts') %>
    </div>

    <% data.forEach(function(post){ %>
        <div class="cont">
            <a class="recipe-card-link" href="/recipes/<%= post.slug %>">
               <li style="display: flex; flex-direction:row">
                    <div>
                        <a style=" font-size: 19px; line-height: 26px;" href="/recipes/<%= post.slug %>"><%=post.title%></a>
                        <% if(post.subtitle){ %>
                        <p class="st"><%=post.subtitle%></p>
                        <% } %>
                    </div>
                    <div class="img-cont" style="margin-left: auto;">
                        <img class="foodpic" src = "/images/<%= post.image %>">
                    </div>
    
                </li>
    
                </a>
            </div>
    
            <hr style="margin-top: 20px">
    <% }) %>

</body>
