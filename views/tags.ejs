<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tags</title>
</head>
<body>
    <h1>All Recipes</h1>
    <h2 class="st">Click on these tags</h2>
    <!-- probably some way in the future to make a list of tags automatically-->
    <div style="display: flex; flex-direction: row;">
        <h3 style="margin-right: 10px">Tags:</h3>
        <!-- rows of tags -->
        <div style="display: flex; flex-direction: column;">
            <div id="possibleTagBox" style="display: flex; flex-direction: row;">
                <div class="tag-cont">
                    <p class="tag tag-Alcohol inactive">Alcohol</p>
                </div>
                <div class="tag-cont">
                    <p class="tag tag-Breakfast inactive">Breakfast</p>
                </div>
                <div class="tag-cont">
                    <p class="tag tag-Coffee inactive">Coffee</p>
                </div>
                <div class="tag-cont">
                    <p class="tag tag-Dessert inactive">Dessert</p>
                </div>
                <div class="tag-cont">
                    <p class="tag tag-Drink inactive">Drink</p>
                </div>
                <div class="tag-cont">
                    <p class="tag tag-Family-sized inactive">Family-sized</p>
                </div>
                <div class="tag-cont">
                    <p class="tag tag-Fish inactive">Fish</p>
                </div>
                <div class="tag-cont">
                    <p class="tag tag-Italian inactive">Italian</p>
                </div>
                <div class="tag-cont">
                    <p class="tag tag-Korean inactive">Korean</p>
                </div>
                <div class="tag-cont">
                    <p class="tag tag-not-a-recipe inactive">Not a recipe</p>
                </div>

            </div>
            <div id="possibleTagBox" style="display: flex; flex-direction: row;">
                <div class="tag-cont">
                    <p class="tag tag-Pasta inactive">Pasta</p>
                </div>
                <div class="tag-cont">
                    <p class="tag tag-Sandwiches inactive">Sandwiches</p>
                </div>
                <div class="tag-cont">
                    <p class="tag tag-Sides inactive">Sides</p>
                </div>
                <div class="tag-cont">
                    <p class="tag tag-Vegetarian inactive">Vegetarian</p>
                </div>
            </div>
        </div>
    </div>

    <br>
    <br>
    <br>
    
    <h2 id="resultCont" class="st" style="display:flex; white-space:pre-wrap">Recipes: </h2>
    <hr>

    <div id="tagPostCont">
    <%- include('partials/foundPosts') %>
    </div>

    <!-- deprecated, i don't think this does anything anymore -->
    <% data.forEach(function(post){ %>
        <div class="cont">
            <a class="recipe-card-link" href="/recipes/<%= post.slug %>">
               <li style="display: flex; flex-direction:row">
                    <div>
                        <a style=" font-size: 19px; line-height: 26px;" href="/recipes/<%= post.slug %>"><%=post.title%></a>
                        <% if(post.subtitle){ %>
                        <p class="st"><%=post.subtitle%></p>
                        <% } %>
                    </div>
                    <div class="img-cont" style="margin-left: auto;">
                        <img class="foodpic" src = "/images/<%= post.image %>">
                    </div>
    
                </li>
    
                </a>
            </div>
    
            <hr style="margin-top: 20px">
    <% }) %>

</body>
<script type="module", src="../main.js"></script>
</html>