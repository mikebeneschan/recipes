
<h1>Mike's recipes</h1>
<h2 id="subheader">This is the homepage</h2>
    <% postlist.forEach(function(post){ %>

        <div class="cont">
        <a class="recipe-card-link" href="/recipes/<%= post.slug %>">
           <li style="display: flex; flex-direction:row">
                <div>
                    <a style=" font-size: 19px; line-height: 26px;" href="/recipes/<%= post.slug %>"><%=post.title%></a>
                    <% if(post.subtitle){ %>
                    <p class="st"><%=post.subtitle%></p>
                    <% } %>
                </div>
                <div class="img-cont" style="margin-left: auto;">
                    <img class="foodpic" src = "/images/<%= post.image %>">
                </div>

            </li>

            </a>
        </div>

        <hr style="margin-top: 20px">
    <% }) %>

<script>
    var subh = document.getElementById("subheader")
    if (subh.classList.contains("dark-mode")) {subh.innerHTML = "This is the homepage (now in dark mode)"}
    // else {subh.innerHTML = "This is the homepage"}
</script>